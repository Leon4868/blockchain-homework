# ---------- 网络选择 ----------
# 纯 node 脚本（read:rpc / read:events）用它选择网络：local | sepolia
# Hardhat 脚本（deploy / write）以 --network 为准，不看这一项。
NETWORK=local

# 临时覆盖 RPC，优先级高于下面各网络的专用变量。平时留空。
RPC_URL=

# ---------- 本地 Hardhat 链 ----------
LOCAL_RPC_URL=http://127.0.0.1:8545
LOCAL_EVENT_STORE_ADDRESS=
LOCAL_FROM_BLOCK=0

# ---------- Sepolia 测试网 ----------
# 完整 RPC URL 含 API Key，只允许存在于本地 .env，不得提交。
SEPOLIA_RPC_URL=
SEPOLIA_EVENT_STORE_ADDRESS=
SEPOLIA_FROM_BLOCK=

# Provider 对比实验用，两个都填才有意义。
INFURA_SEPOLIA_RPC_URL=
ALCHEMY_SEPOLIA_RPC_URL=

# 部署账户私钥，必须是与真实资产隔离的测试钱包。
DEPLOYER_PRIVATE_KEY=

# ---------- 写入内容 ----------
DATA_KEY=course
DATA_VALUE=hello
