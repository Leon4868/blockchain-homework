# 只读 RPC，前端读取事件时使用；写入走 MetaMask 注入的 provider。
VITE_RPC_URL=http://127.0.0.1:8545

# 已部署的 EventStore 地址；留空时可在页面上手动填写。
VITE_EVENT_STORE_ADDRESS=

# 事件扫描起始区块。
VITE_FROM_BLOCK=0

# The Graph 查询端点，留空则页面上的 Subgraph 读取方式不可用。
# 形如 https://api.studio.thegraph.com/query/<id>/<slug>/<version>
VITE_SUBGRAPH_URL=
