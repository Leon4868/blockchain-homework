# dev / preview server 代理的目标节点 REST 地址。
VITE_REST_TARGET=http://localhost:1317

# 前端请求的基址。默认 /api 走同源代理；改成直连地址需要节点开启 enabled-unsafe-cors。
VITE_REST_BASE=/api

# 面额换算：链上最小单位、展示单位、精度。
VITE_DENOM=uedu
VITE_DISPLAY_DENOM=EDU
VITE_DECIMALS=6

# 地址备注，格式 name:address，逗号分隔。地址是公开信息，不含任何私钥。
VITE_ACCOUNT_LABELS=
